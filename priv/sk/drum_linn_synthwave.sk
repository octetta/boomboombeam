# 2030.sk: LinnDrum 80s Synthwave & Italo-Disco 16-Step Groove
# -------------------------------------------------------------
M 118

# Wave Slots:
# 100: Kick (Linn Thud)
# 101: Snare (Linn Crack)
# 102: Closed Hi-Hat
# 103: Mid Tom
# 104: Synthwave Octave Bass
[sk/drums-kick.ks]/ks 1 k>d d>r /r100
[sk/drums-snare.ks]/ks 1 k>d d>r /r101
[sk/drums-chh.ks]/ks 1 k>d d>r /r102
[sk/drums-midtom.ks]/ks 1 k>d d>r /r103
[sk/nap-bass-grind.ks]/ks 1 k>d d>r /r104

# Voice Assignments:
v0 w100 f440 a10          # Kick (Natural unpitched playback)
v1 w101 f440 a8           # Snare
v2 w102 f440 a3           # Closed Hat
v3 w103 f440 a6           # Mid Tom
v4 w104 f440 a6           # Grind Octave Bass (Pitched via note numbers)

# 16-Step Pattern (Full 4/4 Bar @ 118 BPM)
y0
[v0l1 v4n36l1] x0         # Beat 1 Kick + Bass C2
[v4n48l0.5] x1            # Chugging Octave C3
[v2l0.4 v4n36l0.8] x2     # Hat + Bass C2
[v4n48l0.5] x3            # Octave C3
[v0l1 v1l1 v4n36l1] x4    # Beat 2 Kick + Linn Snare Crack
[v4n48l0.5] x5            # Octave C3
[v0l0.8 v4n36l0.8] x6     # Kick + Bass C2
[v4n48l0.5] x7            # Octave C3
[v0l1 v4n36l1] x8         # Beat 3 Kick + Bass C2
[v4n48l0.5] x9            # Octave C3
[v0l0.8 v4n36l0.8] x10    # Kick + Bass C2
[v4n48l0.5] x11           # Octave C3
[v1l1 v4n36l1] x12        # Beat 4 Snare Backbeat
[v3l0.8 z*2 v4n48l0.5] x13# Mid Tom Double-Tap Fill
[v0l0.8 v3l0.8] x14       # Kick + Mid Tom
[v3l0.9 z*2] x15          # Tom Roll Turnaround

# Start Pattern
Z1
