# 2023.sk: Master Ksynth Drum Patch Loading & 16-Step Groove
# -------------------------------------------------------------
M 120

# Load bundled Ksynth drum & synth patches into wave slots:
[sk/drums-kick.ks]/ks 1 k>d d>r /r100
[sk/drums-snare.ks]/ks 1 k>d d>r /r101
[sk/drums-chh.ks]/ks 1 k>d d>r /r102
[sk/gm-lead-moog.ks]/ks 1 k>d d>r /r103

# Voice Setup (Natural root pitch f440 for drums; v0 auto-chokes kick tails):
v0 w100 f440 a10          # Kick
v1 w101 f440 a8           # Snare
v2 w102 f440 a3           # Closed Hat
v3 w103 f220 a8           # Moog Synth Lead

# 16-Step Pattern (Full 4/4 Bar @ 120 BPM)
y0
[v0l1 v3n48l1] x0
[v2l0.4] x1
[v2l0.4] x2
[v2l0.4 v3n51l0.6] x3
[v1l1 v3n48l1] x4
[v2l0.4] x5
[v2l0.4] x6
[v2l0.4 v3n55l0.6] x7
[v0l1 v3n48l1] x8
[v2l0.4] x9
[v0l0.8 v3n58l0.6] x10
[v2l0.4] x11
[v1l1 v3n60l1] x12
[v2l0.4] x13
[v2l0.4 v3n58l0.6] x14
[v1l0.8 z*3] x15          # Triplet Snare Ratchet Fill

# Start Pattern
Z1
