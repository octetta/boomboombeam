# 2025.sk: Trap & IDM Micro-Ratchets (z*3 Triplet, z*4 32nd, z*8 64th)
# --------------------------------------------------------------------
M 120

# Load bundled Ksynth drum & lead patches:
[sk/drums-kick.ks]/ks 1 k>d d>r /r100
[sk/drums-snare.ks]/ks 1 k>d d>r /r101
[sk/drums-chh.ks]/ks 1 k>d d>r /r102
[sk/gm-lead-moog.ks]/ks 1 k>d d>r /r103

# Voice Assignments (Drum voices trigger at natural pitch f440):
v0 w100 f440 a20          # Kick
v1 w101 f440 a15           # Snare
v2 w102 f440 a5           # Closed Hat
v3 w103 f440 a8 N-12      # Moog Lead

# 16-Step Trap Pattern with Micro-Ratchet Hat & Snare Rolls
y0
[v0l1 v3n60l1] x0
[v2l0.4] x1
[v2l0.4] x2
[v2l0.4 z*3] x3           # Triplet Hat Roll
[v1l1 v3n60l1] x4         # Snare Backbeat
[v2l0.4] x5
[v0l0.8] x6
[v2l0.4 z*4] x7           # 32nd-Note Hat Burst
[v0l1 v3n63l1] x8
[v2l0.4] x9
[v0l0.8] x10
[v2l0.4] x11
[v1l1 v3n60l1] x12        # Snare Backbeat
[v2l0.4] x13
[v2l0.4 z*4] x14          # 32nd-Note Hat Burst
[v1l0.9 z*8] x15          # 64th-Note Ultra-Fast Snare Roll Fill!

y1 %32
[v3N-15] x0
[v3N-12] x1
[v3N-5] x2
[v3N-24] x3

# Start Pattern
Z1
